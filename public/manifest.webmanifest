{
  "name": "LocalForge · 本地工坊",
  "short_name": "LocalForge",
  "description": "纯浏览器端的本地工坊：文件、数据与知识皆是原料，55 道工序在本地锤炼成可用成果，全程不出设备。压缩、解压、转码、PDF、图片、OCR、离线词典、诗词格律、中医经典一应俱全。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0d0b09",
  "theme_color": "#e8954a",
  "categories": ["utilities", "productivity", "photo"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "压缩为 ZIP", "short_name": "压缩", "url": "/zip-compress" },
    { "name": "图片工具", "short_name": "图片", "url": "/image-convert" },
    { "name": "二维码工具箱", "short_name": "二维码", "url": "/qr-code" },
    { "name": "OCR 文字识别", "short_name": "OCR", "url": "/ocr" }
  ]
}
